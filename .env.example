# MiMo API Configuration
UNDOMESH_API_KEY=your-api-key-here
UNDOMESH_API_BASE_URL=https://token-plan-cn.xiaomimimo.com/v1
UNDOMESH_MODEL=mimo-v2.5-pro

# Model parameters
UNDOMESH_MAX_TOKENS=8192
UNDOMESH_TEMPERATURE=0.6

# Context limits
UNDOMESH_CONTEXT_LIMIT=131072
UNDOMESH_EXTERNALIZE_THRESHOLD=2000

# Security
UNDOMESH_ALLOW_SHELL=true
UNDOMESH_CONFIRM_DANGEROUS=true
UNDOMESH_SANDBOX_BACKEND=process
UNDOMESH_SANDBOX_NETWORK_ENABLED=false
UNDOMESH_SANDBOX_MEMORY_BYTES=0
UNDOMESH_SANDBOX_CPU_SECONDS=0
UNDOMESH_SANDBOX_PROCESS_COUNT=0
# Advanced Linux embedding only: inherited compiled seccomp BPF file descriptor.
UNDOMESH_SANDBOX_SECCOMP_FD=-1
UNDOMESH_TRANSACTIONAL_CHANGES_ONLY=true
UNDOMESH_TRANSACTION_COMMITTED_RETENTION_DAYS=30
UNDOMESH_TRANSACTION_TERMINAL_RETENTION_DAYS=7
UNDOMESH_TRANSACTION_TRASH_GRACE_DAYS=1
UNDOMESH_TRANSACTION_ORPHAN_GRACE_HOURS=1
UNDOMESH_TRANSACTION_MAX_BACKUP_BYTES=2147483648
UNDOMESH_TRANSACTION_AUTO_PRUNE=true
UNDOMESH_TRANSACTION_PRUNE_INTERVAL_HOURS=6
UNDOMESH_TRANSACTION_BACKUP_ENCRYPTION=true
# Optional 32-byte key as 64 hex characters or base64. If omitted, a local owner-only key is generated.
# UNDOMESH_TRANSACTION_BACKUP_KEY=
UNDOMESH_TRANSACTION_CHUNK_MIN_BYTES=16384
UNDOMESH_TRANSACTION_CHUNK_AVG_BYTES=65536
UNDOMESH_TRANSACTION_CHUNK_MAX_BYTES=262144
UNDOMESH_TRANSACTION_HOT_THRESHOLD_BYTES=268435456
UNDOMESH_TRANSACTION_HOT_TTL_HOURS=24
UNDOMESH_TRANSACTION_HOT_MAX_BACKUP_BYTES=53687091200
UNDOMESH_TRANSACTION_HOT_MINIMUM_FREE_BYTES=2147483648
UNDOMESH_PROJECT_DIR=
UNDOMESH_INSTRUCTION_MAX_BYTES=32768
UNDOMESH_INSTRUCTION_FALLBACK_NAMES=
UNDOMESH_INSTRUCTION_USER_DIR=
UNDOMESH_JOB_DB=data/runtime/jobs.db
UNDOMESH_TELEMETRY_ENABLED=false

# Memory
UNDOMESH_MEMORY_DB=data/memory/undomesh.db
UNDOMESH_MEMORY_ENABLED=true

# Logging
UNDOMESH_LOG_LEVEL=INFO
