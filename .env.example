# MiMo API Configuration
MINICLAUDE_API_KEY=your-api-key-here
MINICLAUDE_API_BASE_URL=https://token-plan-cn.xiaomimimo.com/v1
MINICLAUDE_MODEL=mimo-v2.5-pro

# Model parameters
MINICLAUDE_MAX_TOKENS=8192
MINICLAUDE_TEMPERATURE=0.6

# Context limits
MINICLAUDE_CONTEXT_LIMIT=131072
MINICLAUDE_EXTERNALIZE_THRESHOLD=2000

# Security
MINICLAUDE_ALLOW_SHELL=true
MINICLAUDE_CONFIRM_DANGEROUS=true
MINICLAUDE_SANDBOX_BACKEND=process
MINICLAUDE_SANDBOX_NETWORK_ENABLED=false
MINICLAUDE_SANDBOX_MEMORY_BYTES=0
MINICLAUDE_SANDBOX_CPU_SECONDS=0
MINICLAUDE_SANDBOX_PROCESS_COUNT=0
# Advanced Linux embedding only: inherited compiled seccomp BPF file descriptor.
MINICLAUDE_SANDBOX_SECCOMP_FD=-1
MINICLAUDE_TRANSACTIONAL_CHANGES_ONLY=true
MINICLAUDE_TRANSACTION_COMMITTED_RETENTION_DAYS=30
MINICLAUDE_TRANSACTION_TERMINAL_RETENTION_DAYS=7
MINICLAUDE_TRANSACTION_TRASH_GRACE_DAYS=1
MINICLAUDE_TRANSACTION_ORPHAN_GRACE_HOURS=1
MINICLAUDE_TRANSACTION_MAX_BACKUP_BYTES=2147483648
MINICLAUDE_TRANSACTION_AUTO_PRUNE=true
MINICLAUDE_TRANSACTION_PRUNE_INTERVAL_HOURS=6
MINICLAUDE_TRANSACTION_BACKUP_ENCRYPTION=true
# Optional 32-byte key as 64 hex characters or base64. If omitted, a local owner-only key is generated.
# MINICLAUDE_TRANSACTION_BACKUP_KEY=
MINICLAUDE_TRANSACTION_CHUNK_MIN_BYTES=16384
MINICLAUDE_TRANSACTION_CHUNK_AVG_BYTES=65536
MINICLAUDE_TRANSACTION_CHUNK_MAX_BYTES=262144
MINICLAUDE_TRANSACTION_HOT_THRESHOLD_BYTES=268435456
MINICLAUDE_TRANSACTION_HOT_TTL_HOURS=24
MINICLAUDE_TRANSACTION_HOT_MAX_BACKUP_BYTES=53687091200
MINICLAUDE_TRANSACTION_HOT_MINIMUM_FREE_BYTES=2147483648
MINICLAUDE_PROJECT_DIR=
MINICLAUDE_INSTRUCTION_MAX_BYTES=32768
MINICLAUDE_INSTRUCTION_FALLBACK_NAMES=
MINICLAUDE_INSTRUCTION_USER_DIR=
MINICLAUDE_JOB_DB=data/runtime/jobs.db
MINICLAUDE_TELEMETRY_ENABLED=false

# Memory
MINICLAUDE_MEMORY_DB=data/memory/miniclaude.db
MINICLAUDE_MEMORY_ENABLED=true

# Logging
MINICLAUDE_LOG_LEVEL=INFO
